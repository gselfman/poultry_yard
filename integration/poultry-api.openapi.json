      "Session": {
        "type": "object",
        "description": "Server response with sessionId, kind, seed, engineHash, balanceRevision/snapshot, tick, seq, resumable authoritative state, and rewardPolicyVersion. Final shape must be pinned by the host adapter."
      },
      "Bootstrap": {
        "type": "object",
        "description": "Authenticated user permissions, wallet GE, tickets, unlocked heroes, activeSession, immutable balance revision/snapshot, CSRF token. master permission only for assigned account; no email leaked."
      },
      "Receipt": {
        "type": "object",
        "description": "Persisted server receipt. Includes operation/session IDs, stateRevision, authoritative outcome, account XP and reward entitlements/results. No unverified client totals accepted."
      }
