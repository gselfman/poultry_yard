  "components": {
    "securitySchemes": {
      "quRaSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "REUSE_EXISTING_QURA_SESSION_COOKIE"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "character": {
            "enum": [
              "ryaba",
              "rambo",
              "monk"
            ]
          },
          "protocol": {
            "const": "poultry-v1"
          },
          "engineHash": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "ranked",
              "sandbox"
            ]
          }
        },
        "required": [
          "key",
          "character",
          "protocol",
          "engineHash"
        ]
      },
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "enum": [
              "move",
              "choose",
              "evolve",
              "reroll",
              "revive",
              "decline-revive",
              "continue-bonus",
              "finish"
            ]
          },
          "x": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "purchaseReceiptId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
